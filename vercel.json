{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "buildCommand": "npm run build",
  "functions": {
    "src/index.ts": {
      "includeFiles": [
        "node_modules/@libsql/**",
        "node_modules/@neon-rs/**",
        "node_modules/detect-libc/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
