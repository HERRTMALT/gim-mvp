NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DATABASE_PATH=./data/gym.sqlite

# Generá un secreto con: openssl rand -hex 32
SESSION_SECRET=reemplazar-por-un-secreto-largo

# La cookie de sesión usa Secure automáticamente en producción (requiere HTTPS).
# Para pruebas locales por HTTP, por ejemplo con Docker en http://localhost:3000:
# COOKIE_SECURE=false

# Opción recomendada: guardar el hash y no la contraseña en texto plano.
# Generá el hash con: npm run hash-password -- "tu-contraseña"
# OWNER_PASSWORD_HASH=

# Opción simple para desarrollo. En producción usá OWNER_PASSWORD_HASH.
OWNER_PASSWORD=cambiar-esta-clave

GYM_NAME=Gimnasio
GYM_PHONE=
GYM_ADDRESS=
TZ=America/Argentina/Buenos_Aires
